# MindSync App - Environment Variables

# --- Sync (PocketBase) ---
# Server-side proxy target for /pb (the sync proxy in next.config.ts rewrites).
# Browser code always talks to <app-origin>/pb — same origin, so CSP allows it
# and phones/LAN devices need no extra configuration.
# Docker compose sets this automatically to http://pocketbase:8090.
PB_INTERNAL_URL=http://127.0.0.1:8090

# AI Provider Configuration
# Current provider: StepFun StepPlan API
AI_PROVIDER=stepfun

# StepFun AI
STEPFUN_API_KEY=your_stepfun_key_here
STEPFUN_API_URL=https://api.stepfun.ai/step_plan/v1

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
