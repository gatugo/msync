# MindSync App - Environment Variables

# AI Provider Configuration
# Options: 'stepfun' (default), 'gemini', 'groq'
AI_PROVIDER=stepfun

# StepFun AI (Primary - recommended)
STEPFUN_API_KEY=your_stepfun_key_here
STEPFUN_API_URL=https://api.stepfun.ai/step_plan/v1

# Google Gemini API Key (Optional backup)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq API Key (Optional backup)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
